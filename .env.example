# Public origin for canonical URLs, Open Graph, and the MCP Origin check.
# Optional. The default is https://benchline.fabwaseem.com
NEXT_PUBLIC_SITE_URL=https://benchline.fabwaseem.com

# Used only by scripts/live-mcp-smoke.mts. Optional.
# MCP_URL=https://benchline.fabwaseem.com/mcp

# Optional anonymous usage tracking. Unset DATABASE_URL turns tracking off.
# DATABASE_URL=postgres://user:pass@localhost:5432/benchline
# Daily salt for sha256(salt|utc-date|ip). Raw addresses are not stored.
# ANALYTICS_SALT=
# Bearer token for GET /api/v1/stats. Missing or wrong token is a 404.
# STATS_TOKEN=
# Days of raw events to keep before the daily rollup. Default 90. Range 1..3650.
# ANALYTICS_RETENTION_DAYS=90
# Optional path to the DB-IP country lite mmdb. Default data/dbip-country-lite.mmdb.
# GEOIP_DB_PATH=
# Set to 0 to skip the startup download when the file is missing.
# GEOIP_DOWNLOAD=1
